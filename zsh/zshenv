#!/usr/bin/env zsh
# ~/.zshenv

# ------------------------------------------------------------------------------
# 1. Shell & OS Environment Overrides
# ------------------------------------------------------------------------------
export skip_global_compinit=1                # Skip Ubuntu global compinit for faster startup
export DEBIAN_PREVENT_KEYBOARD_CHANGES=yes   # Prevent debian keyboard layout override
export GSM_SKIP_SSH_AGENT_WORKAROUND=1       # Skip GNOME session SSH agent workaround

# ------------------------------------------------------------------------------
# 2. Default Editors & Pager Settings
# ------------------------------------------------------------------------------
export EDITOR="code --wait"
export VISUAL="${EDITOR}"
export CVSEDITOR="${EDITOR}"
export USE_EDITOR="${EDITOR}"
export SVN_EDITOR="${EDITOR}"
export GIT_EDITOR="${EDITOR}"
export KUBE_EDITOR="${EDITOR}"
export SUDO_EDITOR="${EDITOR}"
export SYSTEMD_EDITOR="nvim"
export XDG_CONFIG_HOME="${HOME}/.config"

export KEYTIMEOUT=1                          # Fast Vi-mode ESC key response (10ms)

# Pager & Less Colors for Man Pages (Selenized Blue Theme)
export PAGER='less'
unset LESSCHARSET                            # Prevent corrupted characters in manpages
export LESS='-i -n -w -z4 -g -M -S -R -X -F'
export GROFF_NO_SGR=1                        # Preserve ANSI color formatting in manpages

export LESS_TERMCAP_mb=$'\E[1;34m'           # Begin blinking (blue)
export LESS_TERMCAP_md=$'\E[1;34m'           # Begin bold (blue)
export LESS_TERMCAP_me=$'\E[0m'              # End mode
export LESS_TERMCAP_se=$'\E[0m'              # End standout-mode
export LESS_TERMCAP_so=$'\E[30;39;100m'      # Begin standout-mode (info box)
export LESS_TERMCAP_ue=$'\E[0m'              # End underline
export LESS_TERMCAP_us=$'\E[4;36m'           # Begin underline (cyan)

# ------------------------------------------------------------------------------
# 3. Tool Configuration & Telemetry Flags
# ------------------------------------------------------------------------------
# .NET & PowerShell
export DOTNET_NOLOGO=true
export DOTNET_CLI_TELEMETRY_OPTOUT=true
export DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=true

# Google Cloud SDK
export CLOUDSDK_PYTHON=python3
export USE_GKE_GCLOUD_AUTH_PLUGIN=True
export CLOUDSDK_HOME="${HOME}/Applications/google-cloud-sdk"

# Enhancd & Zoxide
export ENHANCD_FILTER="fzf:sk"
export ENHANCD_DISABLE_DOT=1
export ENHANCD_DISABLE_HYPHEN=1
export ENHANCD_DISABLE_HOME=1
export ENHANCD_HISTORY_ZOXIDE_BACKEND=true
export ZOXIDE_CMD_OVERRIDE="j"

# Poetry & Python
export POETRY_VENV_IN_PROJECT=1
export POETRY_VIRTUALENVS_CREATE=1
export POETRY_VIRTUALENVS_IN_PROJECT=1
export POETRY_INSTALL_DEPENDENCIES=1
export WORKON_HOME="${HOME}/.local/share/virtualenvs"

# Miscellaneous Tools
export NMAP_PRIVILEGED=""
export MINICOM="-m -c on"
export MTR_OPTIONS="--no-dns"

# ------------------------------------------------------------------------------
# 4. PATH Environment Construction (Deduplicated natively in Zsh)
# ------------------------------------------------------------------------------
export USER_BIN="${HOME}/.local/bin"

if [[ "$OSTYPE" == linux* ]]; then
  export MISE_SHIMS="${HOME}/.local/share/mise/shims"
  export DOOM_EMACS="${HOME}/.config/emacs/bin"
  export PULUMI="${HOME}/.pulumi/bin"
  export KREW_ROOT="${HOME}/.krew"
  export CARGO="${HOME}/.cargo/bin"
  export CABAL="${HOME}/.cabal/bin"
  export FLYCTL_INSTALL="${HOME}/.fly"
  export DOTNET_TOOLS="${HOME}/.dotnet/tools"
  export NPM_PREFIX="${HOME}/.npm-packages"
  export ANDROID_PLATFORM_TOOLS="${HOME}/Applications/android-platform-tools"

  # Native Zsh unique PATH array assignment
  typeset -gU path PATH
  path=(
    "${MISE_SHIMS}"
    "${USER_BIN}"
    "${DOOM_EMACS}"
    "${PULUMI}"
    "${KREW_ROOT}/bin"
    "${CARGO}"
    "${CABAL}"
    "${FLYCTL_INSTALL}/bin"
    "${ANDROID_PLATFORM_TOOLS}"
    "${DOTNET_TOOLS}"
    "${NPM_PREFIX}/bin"
    $path
  )
fi

# ------------------------------------------------------------------------------
# 5. Locales & Input Method Settings
# ------------------------------------------------------------------------------
if [[ "$OSTYPE" == linux* ]]; then
  export MY_INPUT_METHOD="ibus"
  export XMODIFIERS="${XMODIFIERS:-@im=${MY_INPUT_METHOD}}"
  export GTK_IM_MODULE="${GTK_IM_MODULE:-${MY_INPUT_METHOD}}"
  export QT_IM_MODULE="${QT_IM_MODULE:-${MY_INPUT_METHOD}}"
  export QT4_IM_MODULE="${QT4_IM_MODULE:-${MY_INPUT_METHOD}}"
  export CLUTTER_IM_MODULE="${CLUTTER_IM_MODULE:-${MY_INPUT_METHOD}}"

  export LANGUAGE="en_US.UTF-8"
  export LANG="${LANGUAGE}"
  export LC_ALL="${LANGUAGE}"
  export LC_CTYPE="${LANGUAGE}"

  # Systemd user environment import (interactive session only)
  [[ -o interactive ]] && (( ${+commands[systemctl]} )) && systemctl --user import-environment PATH EDITOR KUBE_EDITOR SYSTEMD_EDITOR 2>/dev/null
fi

# ------------------------------------------------------------------------------
# 6. Desktop Session & API Secret Keys (Lazy / Inherited)
# ------------------------------------------------------------------------------
# Query GNOME Keyring only if not already exported in environment
if (( ${+commands[secret-tool]} )); then
  [[ -z "$GEMINI_API_KEY" ]]  && export GEMINI_API_KEY="$(secret-tool lookup api-key gemini 2>/dev/null)"
  [[ -z "$TINYPNG_API_KEY" ]] && export TINYPNG_API_KEY="$(secret-tool lookup api-key tinypng 2>/dev/null)"
  [[ -z "$IPINFO_TOKEN" ]]     && export IPINFO_TOKEN="$(secret-tool lookup token ipinfo.io 2>/dev/null)"
  [[ -z "$MACVENDORS_TOKEN" ]] && export MACVENDORS_TOKEN="$(secret-tool lookup token macvendors 2>/dev/null)"
fi

# End of ~/.zshenv
