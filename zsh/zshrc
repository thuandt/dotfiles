# ------------------------------------------------------------------------------
# 8. Interactive & Vi-Mode Integrations
# ------------------------------------------------------------------------------
_fzf_init() {
  local dir="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/plugins/junegunn---fzf"
  [[ -r "$dir/key-bindings.zsh" ]] && source "$dir/key-bindings.zsh"
  [[ -r "$dir/_fzf_completion" ]] && source "$dir/_fzf_completion"
  (( ${+widgets[fzf-completion]} )) && bindkey -M viins '^I' fzf-completion
}

_history_substring_search_config() {
  # Bind Alt+. to insert last argument of last command
  bindkey -M viins '\e.' insert-last-word

  # Bind terminal-specific up and down keys
  if [[ -n "$terminfo[kcuu1]" ]]; then
    bindkey -M emacs "$terminfo[kcuu1]" history-substring-search-up
    bindkey -M viins "$terminfo[kcuu1]" history-substring-search-up
  fi
  if [[ -n "$terminfo[kcud1]" ]]; then
    bindkey -M emacs "$terminfo[kcud1]" history-substring-search-down
    bindkey -M viins "$terminfo[kcud1]" history-substring-search-down
  fi

  # Bind P and N for EMACS mode
  bindkey -M emacs '^P' history-substring-search-up
  bindkey -M emacs '^N' history-substring-search-down

  # Bind k and j for VI mode
  bindkey -M vicmd 'k' history-substring-search-up
  bindkey -M vicmd 'j' history-substring-search-down

  # Bind Ctrl+Space to accept and execute current suggestion
  bindkey '^ ' autosuggest-execute
}

zvm_after_init_commands+=(
  _history_substring_search_config
  _zsh_autosuggest_start
  _fzf_init
)

# Load keybindings & vi-mode synchronously so prompt 1 matches prompt 2 & onwards
zinit lucid light-mode for \
  jeffreytse/zsh-vi-mode \
  OMZL::key-bindings.zsh

# Early source fzf keybindings & completion for prompt 1 consistency
_fzf_init

zinit wait'0b' lucid light-mode depth=1 for \
  zsh-users/zsh-autosuggestions \
  zsh-users/zsh-history-substring-search

zinit wait'0c' lucid light-mode for thuandt/zsh-config
zinit wait'1a' lucid light-mode nocompletions for thuandt/enhancd

# fzf
zinit wait'1b' lucid light-mode from'gh-r' \
    id-as'junegunn/fzf' \
    atclone'mkdir -p $ZPFX/{bin,man/man1}' \
    atpull'%atclone' \
    dl'https://raw.githubusercontent.com/junegunn/fzf/master/shell/completion.zsh -> _fzf_completion;
      https://raw.githubusercontent.com/junegunn/fzf/master/shell/key-bindings.zsh -> key-bindings.zsh;
      https://raw.githubusercontent.com/junegunn/fzf/master/man/man1/fzf-tmux.1 -> $ZPFX/man/man1/fzf-tmux.1;
      https://raw.githubusercontent.com/junegunn/fzf/master/man/man1/fzf.1 -> $ZPFX/man/man1/fzf.1' \
    nocompile \
    pick'/dev/null' \
    sbin'fzf' \
  for @junegunn/fzf

# ------------------------------------------------------------------------------
# 9. Terminal & History Customizations
# ------------------------------------------------------------------------------
# Tilix VTE integration
if [[ "$OSTYPE" == linux* && ( -n "$TILIX_ID" || -n "$VTE_VERSION" ) ]]; then
  [[ -r /etc/profile.d/vte.sh ]] && source /etc/profile.d/vte.sh
fi

# Prevent saving failed, trivial bare commands, or interactive exit commands to history
zshaddhistory() {
  local line="${1%%$'\n'}"
  local -a line_tokens=( ${(z)line} )
  local cmd="${line_tokens[1]}"

  # 1. Skip terminal exit & clearing commands
  case "$line" in
    clear|exit|history|reset) return 1 ;;
  esac

  # 2. Reject typos & invalid commands
  whence "$cmd" >/dev/null 2>&1 || return 1

  # 3. Resolve nested alias chain (e.g. kg -> k get -> kubectl)
  local real_cmd="$cmd"
  while (( ${+aliases[$real_cmd]} )); do
    local expanded="${aliases[$real_cmd]}"
    local -a expanded_tokens=( ${(z)expanded} )
    local next_cmd="${expanded_tokens[1]}"
    [[ "$next_cmd" == "$real_cmd" ]] && break
    real_cmd="$next_cmd"
  done

  # 4. Discard bare 1-2 char commands without arguments (bare cd, bare ls, bare w)
  if (( $#line_tokens == 1 && ${#real_cmd} < 3 )); then
    return 1
  fi

  return 0
}

# ------------------------------------------------------------------------------
# 10. Finalization
# ------------------------------------------------------------------------------
zinit cdreplay -q
(( ! ${+functions[p10k]} )) || p10k finalize

