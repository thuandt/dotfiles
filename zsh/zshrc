#!/usr/bin/env zsh
# ~/.zshrc

# ------------------------------------------------------------------------------
# 1. Powerlevel10k Instant Prompt (Must stay near the very top of ~/.zshrc)
# ------------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Direnv workaround for p10k instant prompt
(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv export zsh)"

# ------------------------------------------------------------------------------
# 2. Environment Variables & PATH Optimization
# ------------------------------------------------------------------------------
export ZSH_AUTOSUGGEST_STRATEGY=(history completion)
export HIST_STAMPS="yyyy-mm-dd"

# Activate mise early for CLI tools (aws, node, python, go, etc.)
(( ${+commands[mise]} )) && eval "$(mise activate zsh)"

# Cache and completion paths for OMZ & custom completions
: "${ZSH_CACHE_DIR:=${XDG_CACHE_HOME:-$HOME/.cache}/zsh}"
[[ -d "$ZSH_CACHE_DIR/completions" ]] || mkdir -p "$ZSH_CACHE_DIR/completions"
(( ${fpath[(Ie)"$ZSH_CACHE_DIR/completions"]} )) || fpath=("$ZSH_CACHE_DIR/completions" $fpath)

# Direnv hook (below instant prompt)
(( ${+commands[direnv]} )) && emulate zsh -c "$(direnv hook zsh)"

# ------------------------------------------------------------------------------
# 3. Zinit Framework Bootstrap
# ------------------------------------------------------------------------------
export ZINIT_HOME="${XDG_DATA_HOME:-${HOME}/.local/share}/zinit/zinit.git"
if [[ ! -d "$ZINIT_HOME" ]]; then
  mkdir -p "$(dirname "$ZINIT_HOME")/completions"
  git clone https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"
  ln -sf "$ZINIT_HOME/_zinit" "$(dirname "$ZINIT_HOME")/completions/_zinit"
fi

source "${ZINIT_HOME}/zinit.zsh"
autoload -Uz _zinit
(( ${+_comps} )) && _comps[zinit]=_zinit

# ------------------------------------------------------------------------------
# 4. Prompt Theme & Annexes
# ------------------------------------------------------------------------------
zinit light zdharma-continuum/zinit-annex-meta-plugins
zinit lucid light-mode skip"dircolors-material" for annexes zsh-users+fast console-tools

# Powerlevel10k Theme
zinit lucid light-mode nocd depth='1' atload'!source ~/.p10k.zsh; _p9k_precmd' for romkatv/powerlevel10k

# ------------------------------------------------------------------------------
# 5. Core Zsh Libraries & Synchronous Plugins
# ------------------------------------------------------------------------------
zinit lucid light-mode for \
  OMZL::completion.zsh \
  OMZL::functions.zsh \
  OMZL::history.zsh \
  OMZL::clipboard.zsh \
  OMZL::directories.zsh \
  OMZL::grep.zsh \
  OMZL::git.zsh \
  OMZL::theme-and-appearance.zsh \
  OMZP::aws \
  OMZP::azure \
  OMZP::terraform

# Bash & Python CLI completion bridges
for _cmd in az checkov pipenv pipx; do
  if (( ${+commands[$_cmd]} )); then
    (( ${+functions[bashcompinit]} )) || { autoload -Uz bashcompinit && bashcompinit; }
    eval "$(register-python-argcomplete $_cmd)" 2>/dev/null
  fi
done

if (( ${+commands[terraform]} )); then
  (( ${+functions[bashcompinit]} )) || { autoload -Uz bashcompinit && bashcompinit; }
  complete -C terraform terraform
fi
unset _cmd

# ------------------------------------------------------------------------------
# 6. Deferred Plugins (Loaded asynchronously in Turbo mode)
# ------------------------------------------------------------------------------
zinit wait lucid light-mode depth=1 for \
  OMZP::gpg-agent \
  OMZP::ansible \
  OMZP::dotnet \
  OMZP::extract \
  OMZP::encode64 \
  OMZP::firewalld \
