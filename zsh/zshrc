# Programs & Binaries
zinit wait lucid light-mode \
   pick'bin/git-dsf' \
   sbin'bin/git-dsf' \
   sbin'bin/diff-so-fancy' \
   as"program" for thuandt/zsh-diff-so-fancy

# Direnv (from GitHub releases fallback)
zinit wait lucid light-mode as'null' from'gh-r' \
  mv'direnv* -> direnv' \
  sbin'direnv' src'zhook.zsh' \
  atclone'./direnv hook zsh >| zhook.zsh' \
  atpull'%atclone' for direnv/direnv

# Color logger
zinit wait lucid light-mode src'color-logger.bash' pick'/dev/null' for swyckoff/color-logger-bash

# ------------------------------------------------------------------------------
# 7. CLI Completion Caching (Eliminates costly subshell spawns per shell)
# ------------------------------------------------------------------------------
_lazy_cache_completion() {
  local cmd="$1"
  shift
  local comp_file="$ZSH_CACHE_DIR/completions/_$cmd"
  if (( ${+commands[$cmd]} )); then
    if [[ ! -s "$comp_file" || "$commands[$cmd]" -nt "$comp_file" ]]; then
      "$cmd" "$@" >| "$comp_file" 2>/dev/null
    fi
    if [[ -r "$comp_file" ]]; then
      source "$comp_file"
      _comps[$cmd]="_$cmd" 2>/dev/null
    fi
  fi
}

zinit wait'0b' lucid light-mode id-as'cli-completions' atload'
