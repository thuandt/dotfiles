# https://github.com/zsh-users/zsh-autosuggestions/issues/642#issuecomment-2136812444
zinit lucid light-mode depth=1 for \
  atload"!_zsh_autosuggest_start; \
        ZSH_AUTOSUGGEST_STRATEGY=(history completion) \
        ZSH_AUTOSUGGEST_MANUAL_REBIND=0 \
        bindkey '^ ' autosuggest-execute" \
    zsh-users/zsh-autosuggestions \
  atload'_history_substring_search_config; _zsh_autosuggest_start' \
    zsh-users/zsh-history-substring-search

